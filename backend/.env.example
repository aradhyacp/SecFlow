# SecFlow — Environment Variables
# Copy to .env and fill in your actual keys.
#
# docker compose up --build

# ── Core API keys ────────────────────────────────────────────────────────────
# Orchestrator model gateway. Analysis requests fail without this key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# VirusTotal API v3 — Malware Analyzer and Macro Analyzer threat intelligence.
# The analyzers degrade gracefully, but detections are missing without it.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── Optional analyzer API keys ───────────────────────────────────────────────
# Malware Analyzer / Web Analyzer AI narrative endpoints only; the
# orchestrator itself never calls these endpoints.
GEMINI_API_KEY=

# Recon-Analyzer
NUMVERIFY_API_KEY=
THREATFOX_API_KEY=
ipAPI_KEY=

# Web-Analyzer enrichments
BUILT_WITH_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=

# ── Orchestrator settings ────────────────────────────────────────────────────
# OpenRouter model used for routing, rule generation, and report text.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Maximum model decisions per run (must exceed the requested pass count).
MODEL_MAX_CYCLES=12
# Maximum output tokens per model call.
MODEL_MAX_TOKENS=2048
# Per-model-request timeout in milliseconds.
MODEL_TIMEOUT_MS=60000

# Default analyzer HTTP timeout, overridable per analyzer with
# ANALYZER_<NAME>_TIMEOUT_MS (MALWARE/STEG/RECON/WEB/MACRO).
ANALYZER_TIMEOUT_MS=60000
# Overall analysis deadline in milliseconds.
TOTAL_ANALYSIS_TIMEOUT_MS=600000

# Maximum uploaded or downloaded payload size (bytes). Default: 50 MiB.
MAX_UPLOAD_BYTES=52428800

# Allow loopback/private/link-local targets. Keep false in production.
# Enable only for local demos or tests that analyze localhost services.
ALLOW_PRIVATE_TARGETS=false

LOG_LEVEL=info

# ── Steg-Analyzer database password ─────────────────────────────────────────
# Change this in production — used for the steg-postgres container.
STEG_POSTGRES_PASSWORD=secflowpass

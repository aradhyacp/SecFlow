# SecFlow TypeScript Orchestrator — Environment Variables
#
# Copy to .env for local runs, or let docker compose inject the same names.
# All values below are placeholders; never commit real credentials.

# ── OpenRouter (required for analysis) ──────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any tool-calling model from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4.1-mini

# ── Model budget / reliability ───────────────────────────────────────────────
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Maximum model/tool decision cycles per run (independent of the 3/4/5 pass cap).
MODEL_MAX_CYCLES=4

# ── Analyzer services (Docker-internal defaults) ─────────────────────────────
ANALYZER_MALWARE_URL=http://malware-analyzer:5000/api/malware-analyzer
ANALYZER_STEG_URL=http://steg-analyzer:5000/api/steg-analyzer
ANALYZER_RECON_URL=http://recon-analyzer:5000/api/Recon-Analyzer
ANALYZER_WEB_URL=http://web-analyzer:5000/api/web-analyzer
ANALYZER_MACRO_URL=http://macro-analyzer:5000/api/macro-analyzer

# ── Timeouts ────────────────────────────────────────────────────────────────
ANALYZER_TIMEOUT_MS=60000
TOTAL_ANALYSIS_TIMEOUT_MS=600000
# Bounded retries for transient failures (network, timeout, 429/5xx).
# File-upload analyzers always use 0 retries to avoid duplicate heavy scans.
ANALYZER_MAX_RETRIES=1

# Per-analyzer overrides (optional). Ghidra needs the largest budget.
# ANALYZER_MALWARE_TIMEOUT_MS=240000
# ANALYZER_STEG_TIMEOUT_MS=330000
# ANALYZER_WEB_TIMEOUT_MS=300000

# ── Service ─────────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info
REPORTS_DIR=./reports
MAX_UPLOAD_BYTES=52428800

# SSRF guard: loopback/private/metadata targets are blocked unless enabled.
ALLOW_PRIVATE_TARGETS=false

# Lets the service boot without OPENROUTER_API_KEY (readiness stays 503).
# Intended for local UI work only; never enable in production.
ALLOW_MISSING_OPENROUTER_KEY=false
